{
	"name": "@trakoo/posthog",
	"version": "0.0.0",
	"description": "PostHog provider for trakoo",
	"type": "module",
	"exports": {
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js",
			"default": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js",
			"default": "./dist/server.js"
		}
	},
	"files": ["dist", "README.md", "LICENSE"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"keywords": ["analytics", "trakoo", "posthog", "typescript"],
	"author": "Chris Jayden <https://github.com/multiplehats>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/multiplehats/trakoo.git",
		"directory": "packages/posthog"
	},
	"bugs": {
		"url": "https://github.com/multiplehats/trakoo/issues"
	},
	"homepage": "https://trakoo.co/docs/providers/posthog",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"trakoo": "workspace:^",
		"posthog-js": "^1.268.2",
		"posthog-node": "^5.9.0"
	},
	"peerDependenciesMeta": {
		"posthog-js": {
			"optional": true
		},
		"posthog-node": {
			"optional": true
		}
	},
	"devDependencies": {
		"trakoo": "workspace:*",
		"posthog-js": "^1.434.12",
		"posthog-node": "^5.53.0"
	}
}
