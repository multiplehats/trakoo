{
	"name": "@trakoo/openpanel",
	"version": "0.0.0",
	"description": "OpenPanel provider for trakoo",
	"type": "module",
	"exports": {
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js",
			"default": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js",
			"default": "./dist/server.js"
		}
	},
	"files": ["dist", "README.md", "LICENSE"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"keywords": ["analytics", "trakoo", "openpanel", "typescript"],
	"author": "Chris Jayden <https://github.com/multiplehats>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/multiplehats/trakoo.git",
		"directory": "packages/openpanel"
	},
	"bugs": {
		"url": "https://github.com/multiplehats/trakoo/issues"
	},
	"homepage": "https://trakoo.co/docs/providers/openpanel",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"trakoo": "workspace:^",
		"@openpanel/sdk": "^1.3.1",
		"@openpanel/web": "^1.4.1"
	},
	"peerDependenciesMeta": {
		"@openpanel/sdk": {
			"optional": true
		},
		"@openpanel/web": {
			"optional": true
		}
	},
	"devDependencies": {
		"trakoo": "workspace:*",
		"@openpanel/sdk": "^1.3.1",
		"@openpanel/web": "^1.4.1"
	}
}
